+/*
+ * VMware's virtual USB mouse (0e0f:0003) exposes two USB interfaces, hence two
+ * separate HID devices: interface 0 reports the host pointer's ABSOLUTE
+ * position (this is the one that moves while the pointer is not grabbed) and
+ * interface 1 reports RELATIVE motion (only while it is grabbed). ChromeOS
+ * classifies an input device as a mouse only when it has REL_X/REL_Y, and as a
+ * touchscreen/stylus only with ABS_MT_*/BTN_TOOL_*; interface 0 has neither, so
+ * ChromeOS ignores it outright and an ungrabbed pointer moves nothing.
+ *
+ * Rather than relaying between the two devices the way openFyde's
+ * 066-fix-vmware-usb-mouse.patch does - which assumes both interfaces enumerate
+ * in a fixed order and leaves the absolute one unregistered - present interface
+ * 0 as an ordinary relative mouse: advertise REL_X/REL_Y, drop the absolute
+ * axes, and turn each absolute position into a delta. Buttons and wheels are
+ * already reported by this same device, so they need no special handling, and
+ * nothing breaks if VMware ever presents only one interface.
+ */
+#define VMWARE_MOUSE_VENDOR	0x0e0f
+#define VMWARE_MOUSE_PRODUCT	0x0003
+
+static struct input_dev *vmware_mouse_abs;
+static int vmware_mouse_last_x = -1;
+static int vmware_mouse_last_y = -1;
+
+static bool is_vmware_mouse(struct input_dev *dev)
+{
+	return dev->id.vendor == VMWARE_MOUSE_VENDOR &&
+	       dev->id.product == VMWARE_MOUSE_PRODUCT;
+}
+
+static void vmware_mouse_setup(struct input_dev *dev)
+{
+	if (!is_vmware_mouse(dev) || !test_bit(ABS_X, dev->absbit) ||
+	    test_bit(REL_X, dev->relbit))
+		return;
+
+	input_set_capability(dev, EV_REL, REL_X);
+	input_set_capability(dev, EV_REL, REL_Y);
+	/* Drop the absolute axes so the device is unambiguously a mouse (they
+	 * would otherwise also attract the joystick handler). */
+	__clear_bit(ABS_X, dev->absbit);
+	__clear_bit(ABS_Y, dev->absbit);
+	if (bitmap_empty(dev->absbit, ABS_CNT))
+		__clear_bit(EV_ABS, dev->evbit);
+
+	vmware_mouse_abs = dev;
+	vmware_mouse_last_x = -1;
+	vmware_mouse_last_y = -1;
+}
+
+static void vmware_mouse_forget(struct input_dev *dev)
+{
+	if (dev == vmware_mouse_abs)
+		vmware_mouse_abs = NULL;
+}
+
+/* Returns true when the event was consumed and must not be reported as-is. */
+static bool vmware_mouse_relay(struct input_dev *input, unsigned int type,
+			       unsigned int code, int value)
+{
+	int *last;
+
+	if (input != vmware_mouse_abs || type != EV_ABS)
+		return false;
+
+	if (code == ABS_X)
+		last = &vmware_mouse_last_x;
+	else if (code == ABS_Y)
+		last = &vmware_mouse_last_y;
+	else
+		return true;
+
+	/* The first position seen is a reference, not a movement; emitting it
+	 * as a delta would fling the cursor across the screen. */
+	if (*last >= 0 && value != *last)
+		input_event(input, EV_REL, code == ABS_X ? REL_X : REL_Y,
+			    value - *last);
+	*last = value;
+	return true;
+}
